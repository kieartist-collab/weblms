# Cloudflare Pages response headers (netlify.toml is not read by Cloudflare).
# Block other sites from framing Zuno (clickjacking). YouTube embeds inside Zuno are unaffected.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
